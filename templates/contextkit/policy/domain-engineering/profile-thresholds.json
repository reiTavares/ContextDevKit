{
  "schemaVersion": 1,
  "policyVersion": "0.1.0",
  "id": "profile-thresholds",
  "title": "Implementation Profile resolution — ADR-0128 plan §8",
  "ruleClass": "advisory",
  "maximumAutomaticLevel": "advisory",
  "note": "Profile is an optional recommendation derived from code intent, domain applicability, risk, blast radius and materiality. It never requires a squad, artifact or gate.",
  "profiles": {
    "no-code": {
      "rank": 0,
      "appliesWhen": "cmisVerdict === 'NO_CODE'",
      "recommendedAgents": [],
      "recommendedArtifacts": [],
      "simulateImpactRecommended": false
    },
    "simple": {
      "rank": 1,
      "recommendedAgents": ["implementation-engineer"],
      "recommendedArtifacts": [],
      "simulateImpactRecommended": false
    },
    "modular": {
      "rank": 2,
      "recommendedAgents": ["implementation-engineer", "code-reviewer", "test-engineer"],
      "recommendedArtifacts": ["contract-notes"],
      "simulateImpactRecommended": false
    },
    "domain-driven": {
      "rank": 3,
      "recommendedAgents": ["implementation-engineer", "code-reviewer", "test-engineer", "architect"],
      "recommendedArtifacts": ["domain-map", "contract-notes"],
      "simulateImpactRecommended": true
    },
    "distributed-domain": {
      "rank": 4,
      "recommendedAgents": ["implementation-engineer", "code-reviewer", "test-engineer", "architect", "security"],
      "recommendedArtifacts": ["domain-map", "context-map", "contract-notes"],
      "simulateImpactRecommended": true
    }
  },
  "escalation": {
    "note": "Inherited signals can RAISE but never LOWER the DAS-derived profile rank. They never fabricate domain ceremony for NO_CODE / simple work below the domain floor.",
    "riskHighRaisesTo": "modular",
    "riskCriticalRaisesTo": "domain-driven",
    "blastRadiusCrossCuttingRaisesTo": "domain-driven",
    "materialityHighRaisesTo": "domain-driven",
    "materialityHighThreshold": 0.7
  }
}
