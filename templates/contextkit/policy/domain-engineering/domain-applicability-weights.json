    "isolatedScript": { "weight": -25, "tokens": ["one-off script", "isolated script", "throwaway", "standalone script", "script pontual", "script isolado", "script descartável", "script descartavel", "script autônomo", "script autonomo"] },
    "visualOnly": { "weight": -20, "tokens": ["visual only", "styling", "css", "layout tweak", "ui polish", "somente visual", "estilização", "estilizacao", "ajuste de layout", "polimento de ui"] },
    "configOrDocs": { "weight": -20, "tokens": ["config change", "configuration", "documentation", "readme", "mudança de configuração", "mudanca de configuracao", "configuração", "configuracao", "documentação", "documentacao"] },
