    "transactionalBoundary": { "weight": 15, "tokens": ["transaction", "consistency boundary", "atomic", "rollback", "two-phase", "transação", "transacao", "limite de consistência", "limite de consistencia", "atômico", "atomico"] },
    "publicContract": { "weight": 15, "tokens": ["public api", "public contract", "schema", "event contract", "endpoint contract", "api pública", "api publica", "contrato público", "contrato publico", "contrato de evento"] },
    "crossContextIntegration": { "weight": 15, "tokens": ["integration", "cross-service", "inter-module", "external system", "integração", "integracao", "entre serviços", "entre servicos", "sistema externo"] },
    "centralDurableCapability": { "weight": 15, "tokens": ["core capability", "central capability", "durable capability", "platform capability", "capacidade central", "capacidade durável", "capacidade duravel", "capacidade da plataforma"] },
    "multipleActors": { "weight": 10, "tokens": ["multiple actors", "several roles", "different users", "actor", "múltiplos atores", "multiplos atores", "vários papéis", "varios papeis", "usuários diferentes", "usuarios diferentes"] },
    "recurringVocabulary": { "weight": 10, "tokens": ["ubiquitous language", "domain vocabulary", "domain term", "glossary", "linguagem ubíqua", "linguagem ubiqua", "vocabulário de domínio", "vocabulario de dominio", "glossário", "glossario"] },
    "domainEvent": { "weight": 10, "tokens": ["domain event", "async event", "published event", "event-driven", "evento de domínio", "evento de dominio", "evento assíncrono", "evento assincrono", "evento publicado"] }
